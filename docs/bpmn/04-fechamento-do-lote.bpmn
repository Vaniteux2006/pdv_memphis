<?xml version="1.0" encoding="UTF-8"?>
<!--
  04 — Fechamento do lote (ZIP → Excel → marcar baixado → purge)
  Artefato NORMATIVO (BPMN 2.0). O ZIP é montado NO NAVEGADOR (JSZip) baixando cada
  imagem do Cloudinary; recusada nunca entra no manifesto. Purge é ação explícita.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Defs_FechamentoLote"
                  targetNamespace="http://memphis-pdv/bpmn/04-fechamento-do-lote"
                  exporter="Memphis PDV (plano LGPD)" exporterVersion="1.0">

  <bpmn:collaboration id="Colab_Lote">
    <bpmn:participant id="Part_CloudinaryLote" name="Cloudinary (imagens)" />
    <bpmn:participant id="Part_EquipeLote" name="Equipe (admin — permissão fotos)" processRef="Process_Lote" />
    <bpmn:participant id="Part_MongoLote" name="MongoDB Atlas (metadados)" />
    <bpmn:messageFlow id="MF_BaixaImagens" name="baixa cada imagem (URL assinada)" sourceRef="Task_MontaZip" targetRef="Part_CloudinaryLote" />
    <bpmn:messageFlow id="MF_MarcaBaixado" name="baixado = true" sourceRef="Task_MarcaBaixadas" targetRef="Part_MongoLote" />
    <bpmn:messageFlow id="MF_PurgeCloud" name="apaga as imagens" sourceRef="Task_PurgeLote" targetRef="Part_CloudinaryLote" />
    <bpmn:messageFlow id="MF_PurgeMongo" name="apaga os registros" sourceRef="Task_PurgeLote" targetRef="Part_MongoLote" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Lote" isExecutable="false">
    <bpmn:startEvent id="Start_LotePronto" name="Lote da semana pronto pra fechar">
      <bpmn:outgoing>L01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_FiltraAprovadas" name="Filtra aprovadas ainda não baixadas (recusada fica fora)">
      <bpmn:incoming>L01</bpmn:incoming>
      <bpmn:outgoing>L02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Manifesto" name="Gera o manifesto de download (pasta: Região / REF - Cliente - Promotor)">
      <bpmn:incoming>L02</bpmn:incoming>
      <bpmn:outgoing>L03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_MontaZip" name="Navegador baixa as imagens e monta o ZIP (JSZip)">
      <bpmn:incoming>L03</bpmn:incoming>
      <bpmn:outgoing>L04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_SalvaZip" name="Confere e salva o ZIP no servidor interno">
      <bpmn:incoming>L04</bpmn:incoming>
      <bpmn:outgoing>L05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_MarcaBaixadas" name="Marca as fotos como baixadas">
      <bpmn:incoming>L05</bpmn:incoming>
      <bpmn:outgoing>L06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ExcelLote" name="Exporta o Excel (molde oficial)">
      <bpmn:incoming>L06</bpmn:incoming>
      <bpmn:outgoing>L07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_LimparAgora" name="Limpar os baixados agora?">
      <bpmn:incoming>L07</bpmn:incoming>
      <bpmn:outgoing>L08</bpmn:outgoing>
      <bpmn:outgoing>L10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PurgeLote" name="Purge: apaga do Mongo e do Cloudinary">
      <bpmn:incoming>L08</bpmn:incoming>
      <bpmn:outgoing>L09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_LoteFechado" name="Lote fechado">
      <bpmn:incoming>L09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_FicaAteRetencao" name="Ficam até a retenção (processo 05)">
      <bpmn:incoming>L10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="L01" sourceRef="Start_LotePronto" targetRef="Task_FiltraAprovadas" />
    <bpmn:sequenceFlow id="L02" sourceRef="Task_FiltraAprovadas" targetRef="Task_Manifesto" />
    <bpmn:sequenceFlow id="L03" sourceRef="Task_Manifesto" targetRef="Task_MontaZip" />
    <bpmn:sequenceFlow id="L04" sourceRef="Task_MontaZip" targetRef="Task_SalvaZip" />
    <bpmn:sequenceFlow id="L05" sourceRef="Task_SalvaZip" targetRef="Task_MarcaBaixadas" />
    <bpmn:sequenceFlow id="L06" sourceRef="Task_MarcaBaixadas" targetRef="Task_ExcelLote" />
    <bpmn:sequenceFlow id="L07" sourceRef="Task_ExcelLote" targetRef="GW_LimparAgora" />
    <bpmn:sequenceFlow id="L08" name="Sim" sourceRef="GW_LimparAgora" targetRef="Task_PurgeLote" />
    <bpmn:sequenceFlow id="L09" sourceRef="Task_PurgeLote" targetRef="End_LoteFechado" />
    <bpmn:sequenceFlow id="L10" name="Não" sourceRef="GW_LimparAgora" targetRef="End_FicaAteRetencao" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagrama_04">
    <bpmndi:BPMNPlane id="Plano_04" bpmnElement="Colab_Lote">
      <bpmndi:BPMNShape id="Part_CloudinaryLote_di" bpmnElement="Part_CloudinaryLote" isHorizontal="true">
        <dc:Bounds x="600" y="80" width="350" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_EquipeLote_di" bpmnElement="Part_EquipeLote" isHorizontal="true">
        <dc:Bounds x="160" y="200" width="1440" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_MongoLote_di" bpmnElement="Part_MongoLote" isHorizontal="true">
        <dc:Bounds x="700" y="620" width="350" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_LotePronto_di" bpmnElement="Start_LotePronto">
        <dc:Bounds x="222" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="185" y="405" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FiltraAprovadas_di" bpmnElement="Task_FiltraAprovadas">
        <dc:Bounds x="300" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Manifesto_di" bpmnElement="Task_Manifesto">
        <dc:Bounds x="450" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MontaZip_di" bpmnElement="Task_MontaZip">
        <dc:Bounds x="600" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SalvaZip_di" bpmnElement="Task_SalvaZip">
        <dc:Bounds x="750" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarcaBaixadas_di" bpmnElement="Task_MarcaBaixadas">
        <dc:Bounds x="900" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExcelLote_di" bpmnElement="Task_ExcelLote">
        <dc:Bounds x="1050" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_LimparAgora_di" bpmnElement="GW_LimparAgora" isMarkerVisible="true">
        <dc:Bounds x="1200" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1182" y="315" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PurgeLote_di" bpmnElement="Task_PurgeLote">
        <dc:Bounds x="1300" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_LoteFechado_di" bpmnElement="End_LoteFechado">
        <dc:Bounds x="1460" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1443" y="405" width="72" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_FicaAteRetencao_di" bpmnElement="End_FicaAteRetencao">
        <dc:Bounds x="1207" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1165" y="522" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="L01_di" bpmnElement="L01"><di:waypoint x="258" y="380" /><di:waypoint x="300" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="L02_di" bpmnElement="L02"><di:waypoint x="400" y="380" /><di:waypoint x="450" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="L03_di" bpmnElement="L03"><di:waypoint x="550" y="380" /><di:waypoint x="600" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="L04_di" bpmnElement="L04"><di:waypoint x="700" y="380" /><di:waypoint x="750" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="L05_di" bpmnElement="L05"><di:waypoint x="850" y="380" /><di:waypoint x="900" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="L06_di" bpmnElement="L06"><di:waypoint x="1000" y="380" /><di:waypoint x="1050" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="L07_di" bpmnElement="L07"><di:waypoint x="1150" y="380" /><di:waypoint x="1200" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="L08_di" bpmnElement="L08">
        <di:waypoint x="1250" y="380" /><di:waypoint x="1300" y="380" />
        <bpmndi:BPMNLabel><dc:Bounds x="1262" y="360" width="24" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="L09_di" bpmnElement="L09"><di:waypoint x="1400" y="380" /><di:waypoint x="1460" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="L10_di" bpmnElement="L10">
        <di:waypoint x="1225" y="405" /><di:waypoint x="1225" y="482" />
        <bpmndi:BPMNLabel><dc:Bounds x="1232" y="435" width="26" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MF_BaixaImagens_di" bpmnElement="MF_BaixaImagens">
        <di:waypoint x="650" y="340" /><di:waypoint x="650" y="140" />
        <bpmndi:BPMNLabel><dc:Bounds x="658" y="230" width="190" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_MarcaBaixado_di" bpmnElement="MF_MarcaBaixado">
        <di:waypoint x="950" y="420" /><di:waypoint x="950" y="620" />
        <bpmndi:BPMNLabel><dc:Bounds x="958" y="580" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_PurgeCloud_di" bpmnElement="MF_PurgeCloud">
        <di:waypoint x="1350" y="340" /><di:waypoint x="1350" y="110" /><di:waypoint x="950" y="110" />
        <bpmndi:BPMNLabel><dc:Bounds x="1000" y="90" width="110" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_PurgeMongo_di" bpmnElement="MF_PurgeMongo">
        <di:waypoint x="1350" y="420" /><di:waypoint x="1350" y="650" /><di:waypoint x="1050" y="650" />
        <bpmndi:BPMNLabel><dc:Bounds x="1090" y="658" width="120" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
